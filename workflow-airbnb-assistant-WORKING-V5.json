      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        400
      ],
      "id": "2161a084-f2d1-4019-b0cc-34018dc9f60c",
      "name": "HTTP Request - OpenAI API",
      "credentials": {
        "openAiApi": {
          "id": "ylLSDKqy6FMi3jmk",
          "name": "OpenAi Airbnb WA-Tests n8n"
        },
        "httpHeaderAuth": {
          "id": "jc6tEtJnwhgseXLT",
          "name": "OpenAI-n8n-airbnb-wa"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Gérer les cas où les nodes n'ont pas été exécutés\nconst allInputs = $input.all();\nconst faqData = allInputs.filter(item => item.json.content);\nconst historyData = allInputs.filter(item => item.json.message);\n\nconst faqContext = faqData.length > 0 \n  ? faqData.map(item => item.json.content).join('\\n\\n')\n  : 'Aucune FAQ disponible';\n\nconst conversationHistory = historyData.length > 0\n  ? historyData.map(item => {\n      // CORRECTION: Parser le JSON si c'est une string\n      const msg = typeof item.json.message === 'string' \n        ? JSON.parse(item.json.message) \n        : item.json.message;\n      return `${msg.type}: ${msg.content}`;\n    }).reverse().join('\\n')\n  : 'Première conversation';\n\n// Récupérer les données user depuis le node précédent\nconst detectPropertyData = $('Code - Detect Property (Main)').first().json;\nconst originalMessage = $('When chat message received').first().json.chatInput;\n\n// Obtenir la date actuelle pour le contexte\nconst now = new Date();\nconst currentYear = now.getFullYear();\nconst currentDate = now.toISOString().split('T')[0]; // Format YYYY-MM-DD\n\nconst systemPrompt = `Tu es l'assistant WhatsApp pour un logement Airbnb.\n\nDATE ACTUELLE: ${currentDate} (nous sommes en ${currentYear})\n\nDATES UTILISATEUR ACTUELLES:\n- Arrivée: ${detectPropertyData.date_arrivee || 'NON RENSEIGNÉE'}\n- Départ: ${detectPropertyData.date_depart || 'NON RENSEIGNÉE'}\n\nINFORMATIONS LOGEMENT (FAQ):\n${faqContext}\n\nHISTORIQUE CONVERSATION:\n${conversationHistory}\n\nINSTRUCTIONS:\n1. Si c'est la première interaction, commence ta réponse par 'Bonjour ! Je suis l'assistant pour [nom logement].' Puis dans la suite de la discussion avec le même utilisateur, ne redis pas \"bonjour, je suis...\"\n2. Réponds dans la langue de l'utilisateur de manière concise et amicale (style WhatsApp)\n3. Si l'utilisateur mentionne des dates d'arrivée/départ, extrais-les\n   IMPORTANT: Utilise l'année ${currentYear} pour les dates futures (pas ${currentYear - 1})\n4. CRITIQUE : Si les dates ne sont pas connues, DEMANDE TOUJOURS : \"Pour mieux vous aider, pourriez-vous m'indiquer vos dates de séjour (arrivée et départ) ?\" Une fois qu'il a répondu avec ses dates, ne lui demande plus.\n5. Si tu ne peux pas répondre à une question d'après ta FAQ, indique-le clairement\n6. À la fin de ta réponse, ajoute une ligne <data> si tu détectes des informations structurées:\n<data>\n{\n  \"date_arrivee\": \"YYYY-MM-DD ou null\",\n  \"date_depart\": \"YYYY-MM-DD ou null\",\n  \"needs_human\": true ou false\n}\n</data>`;\n\nreturn {\n  system_prompt: systemPrompt,\n  user_message: originalMessage,\n  user_id: detectPropertyData.user_id,\n  property_id: detectPropertyData.property_id,\n  num_whatsapp: detectPropertyData.num_whatsapp\n};"
      },
      "id": "f0a7b59a-c0aa-49ef-9e7f-e16c94d69f93",
      "name": "Code - Prepare OpenAI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Récupérer la réponse JSON du nœud précédent (HTTP Request)\nconst response = $input.first().json;\n\n// Sécurité : Vérifier si la réponse est valide\nif (!response.choices || response.choices.length === 0) {\n  console.error(\"La réponse d'OpenAI est invalide ou ne contient pas de 'choices'.\");\n  return { error: \"Réponse invalide d'OpenAI\" };\n}\n\n// 2. Extraire le contenu textuel de la réponse d'OpenAI\nconst openAIContent = response.choices[0].message.content;\n\n// 3. Extraire les données structurées (le bloc <data>)\nlet structuredData = null;\n// Utilise une expression régulière pour trouver le bloc <data>\nconst dataMatch = openAIContent.match(/<data>([\\s\\S]*?)<\\/data>/);\n\nif (dataMatch && dataMatch[1]) {\n  try {\n    // Essaye de parser le contenu JSON trouvé dans le bloc <data>\n    structuredData = JSON.parse(dataMatch[1].trim());\n    \n    // POST-CORRECTION: Vérifier et corriger l'année des dates si elles sont dans le passé\n    if (structuredData) {\n      const now = new Date();\n      const currentYear = now.getFullYear();\n      \n      // Corriger date_arrivee si elle est dans le passé\n      if (structuredData.date_arrivee && structuredData.date_arrivee !== 'null') {\n        const arrivalDate = new Date(structuredData.date_arrivee);\n        if (!isNaN(arrivalDate.getTime()) && arrivalDate < now) {\n          // La date est dans le passé, changer l'année pour l'année courante\n          const [year, month, day] = structuredData.date_arrivee.split('-');\n          structuredData.date_arrivee = `${currentYear}-${month}-${day}`;\n        }\n      }\n      \n      // Corriger date_depart si elle est dans le passé\n      if (structuredData.date_depart && structuredData.date_depart !== 'null') {\n        const departureDate = new Date(structuredData.date_depart);\n        if (!isNaN(departureDate.getTime()) && departureDate < now) {\n          // La date est dans le passé, changer l'année pour l'année courante\n          const [year, month, day] = structuredData.date_depart.split('-');\n          structuredData.date_depart = `${currentYear}-${month}-${day}`;\n        }\n      }\n    }\n  } catch (e) {\n    console.error(\"Erreur de parsing du JSON des données structurées :\", e);\n    structuredData = null; // En cas d'erreur, on ne garde rien\n  }\n}\n\n// 4. Nettoyer la réponse pour l'utilisateur (enlever le bloc <data>)\nconst cleanedResponse = openAIContent.replace(/<data>[\\s\\S]*?<\\/data>/, '').trim();\n\n// 5. Renvoyer les données prêtes pour la suite du workflow\n// CORRECTION: Récupérer num_whatsapp depuis Code - Prepare OpenAI Context\nconst preparedData = $('Code - Prepare OpenAI Context').item.json;\n\nreturn {\n  user_id: preparedData.user_id,\n  property_id: preparedData.property_id,\n  num_whatsapp: preparedData.num_whatsapp,\n  bot_response: cleanedResponse,\n  structured_data: structuredData,\n  raw_response: response\n};"
      },
      "id": "b91651b4-1490-4cdc-8243-9f53a6208cbc",
      "name": "Code - Parse OpenAI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Démarrer le tableau avec le message système\nconst messages = [{\n  role: 'system',\n  content: $('Code - Prepare OpenAI Context').item.json.system_prompt\n}];\n\n// 2. Récupérer l'historique de Supabase\nconst history = $('Supabase - Get History').all();\n\n// 3. Ajouter chaque message de l'historique au tableau\nfor (const item of history) {\n  // CORRECTION: Parser le JSON si c'est une string\n  const msgData = item.json.message;\n  const msg = typeof msgData === 'string' ? JSON.parse(msgData) : msgData;\n  \n  if (msg && msg.content) {\n    messages.push({\n      role: msg.type === 'human' ? 'user' : 'assistant',\n      content: msg.content\n    });\n  }\n}\n\n// 4. Ajouter le dernier message de l'utilisateur\nmessages.push({\n  role: 'user',\n  content: $('Code - Prepare OpenAI Context').item.json.user_message\n});\n\n// 5. Renvoyer le tableau final\nreturn {\n  messages: messages\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
