      "id": "6a4cb905-7e6e-4560-9401-63035159d993",
      "name": "Send a message to owner",
      "webhookId": "4db18a41-2ebf-44fc-8b39-c0965301deba",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Récupérer les données utilisateur\nconst userData = $input.first().json;\nconst dateDepart = userData.date_depart;\n\n// Vérifier si la date de départ est absente ou invalide\n// Cas à gérer: null, undefined, '', '=', '==', ou toute chaîne non-date\nconst isInvalidOrMissing = (\n  !dateDepart || \n  dateDepart === '' || \n  dateDepart === null || \n  dateDepart === undefined || \n  dateDepart === 'null' ||\n  dateDepart === '=' ||\n  dateDepart === '==' ||\n  typeof dateDepart !== 'string' ||\n  dateDepart.trim() === '' ||\n  dateDepart.startsWith('=')\n);\n\nif (isInvalidOrMissing) {\n  // Pas de date valide → accès autorisé (nouvel utilisateur ou date non renseignée)\n  return { ...userData, access_granted: true, reason: 'no_valid_departure_date' };\n}\n\n// Si date de départ existe et semble valide, vérifier si elle est dans le futur\ntry {\n  const departureDate = new Date(dateDepart);\n  const now = new Date();\n  \n  // Vérifier que la date est valide\n  if (isNaN(departureDate.getTime())) {\n    // Date invalide → accès autorisé par défaut\n    return { ...userData, access_granted: true, reason: 'invalid_date_format' };\n  }\n  \n  // Réinitialiser les heures pour comparer uniquement les dates\n  departureDate.setHours(0, 0, 0, 0);\n  now.setHours(0, 0, 0, 0);\n  \n  // Accès autorisé si la date de départ est aujourd'hui ou dans le futur\n  if (departureDate >= now) {\n    return { ...userData, access_granted: true, reason: 'departure_date_valid' };\n  } else {\n    // Accès refusé : séjour terminé\n    return { ...userData, access_granted: false, reason: 'stay_ended' };\n  }\n} catch (e) {\n  // En cas d'erreur de parsing de date, autoriser l'accès\n  return { ...userData, access_granted: true, reason: 'date_parse_error' };\n}"
      },
