      ],
      "id": "a3f9ce43-e9b1-4a52-8a6f-9efdef599313",
      "name": "HTTP Request - OpenAI API",
      "credentials": {
        "openAiApi": {
          "id": "ylLSDKqy6FMi3jmk",
          "name": "OpenAi Airbnb WA-Tests n8n"
        },
        "httpHeaderAuth": {
          "id": "jc6tEtJnwhgseXLT",
